<?xml version="1.0" encoding="utf-8"?>
<!-- Basic paged image reader. Plain inflation (no DataBinding). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0C0C10"
    android:padding="16dp">

    <TextView
        android:id="@+id/pageCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0 / 0"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <ImageView
        android:id="@+id/pageImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitCenter"
        android:background="#FF14141A"
        android:contentDescription="漫画页面" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="返回"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:background="#FF2A2A33" />

        <Button
            android:id="@+id/prevButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="上一页"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:background="#FF2A2A33" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="下一页"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:background="#FF2A2A33" />
    </LinearLayout>

</LinearLayout>