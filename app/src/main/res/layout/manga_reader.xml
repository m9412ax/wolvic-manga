<?xml version="1.0" encoding="utf-8"?>
<!-- Independent floating reader window. There is NO control bar here: every
     persistent control lives in Wolvic's original tray widget. Only a page
     indicator overlay and a transient page-jump dialog are rendered here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <FrameLayout
        android:id="@+id/pageStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/pageImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="漫画页面" />

        <TextureView
            android:id="@+id/videoTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Continuous (webtoon) mode draws the previous/current/next pages as
             one seamless vertical strip. Each page stays a separate bitmap so
             we never hit Android's single-bitmap Canvas draw limit. -->
        <com.igalia.wolvic.ui.widgets.MangaStripView
            android:id="@+id/stripView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/brightnessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:clickable="false" />

    <TextView
        android:id="@+id/pageCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/manga_pill_bg"
        android:text="0 / 0"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp" />

    <!-- Centered loading indicator with progress bar + download speed. Shown
         for every manga page / video while its bytes are still downloading. -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="22dp"
        android:background="@drawable/manga_overlay_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在加载…"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/loadingSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#FFB0B0B8"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/readerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text=""
        android:textColor="#FFDDDDDD"
        android:textSize="22sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/gotoDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FF202028"
        android:visibility="gone">

        <TextView
            android:id="@+id/gotoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跳转页码"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/gotoInput"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/gotoConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跳转"
                android:textSize="18sp" />

            <Button
                android:id="@+id/gotoCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The grab bar is now a separate floating widget (MangaDragBarWidget):
         it lives in the gap between this surface and the tray, and dragging it
         moves this surface AND the tray together. This id is kept (hidden and
         zero-height) for source compatibility only. -->
    <LinearLayout
        android:id="@+id/readerDragBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/manga_pill_bg"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="72dp"
            android:layout_height="5dp"
            android:layout_marginEnd="12dp"
            android:background="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="拖动移动窗口"
            android:textColor="#FFD0D0DC"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
