<?xml version="1.0" encoding="utf-8"?>
<!-- Manga content panel only. Page switching lives in Wolvic's original tray
     widget (see tray.xml), so this layout has NO custom bottom tab bar. A slim
     bottom bar (dragBar) lets the whole panel be repositioned; it mirrors the
     browser window's bottom chrome. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/manga_panel_bg"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/libraryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="漫画书架"
            android:textColor="#FFDDE4E3"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settingsShortcutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ 自定义快捷键"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:background="#FF1A2120"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/pageHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  拖动下方白条可移动位置"
            android:textColor="#FF8A8A96"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/manga_inner_bg"
        android:clipToOutline="true">

        <LinearLayout
            android:id="@+id/libraryPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未找到漫画。请将漫画文件夹放入 /sdcard/Manga 后重试。"
                android:textColor="#FFB0B0B8"
                android:textSize="22sp"
                android:visibility="gone" />

            <com.igalia.wolvic.ui.views.CustomRecyclerView
                android:id="@+id/mangaGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />
        </LinearLayout>
    </FrameLayout>

    <!-- The grab bar is now a separate floating widget (MangaDragBarWidget)
         in the gap between the shelf and the tray. This id is kept hidden with
         zero height for source compatibility only. -->
    <LinearLayout
        android:id="@+id/dragBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="#FF2A2A33"
        android:clickable="false"
        android:focusable="false">

        <View
            android:layout_width="72dp"
            android:layout_height="5dp"
            android:layout_margin="2dp"
            android:background="#FF6A6A78" />
    </LinearLayout>

</LinearLayout>
