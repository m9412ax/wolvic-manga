<?xml version="1.0" encoding="utf-8"?>
<!-- Slider setting row: label, minus/plus step buttons, SeekBar and value.
     The step buttons matter in VR where a precise drag is awkward. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/mangaRowLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="@color/fog"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mangaSliderMinus"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#FF80D5D2"
            android:textSize="20sp"
            android:background="@drawable/manga_card_bg"
            android:clickable="true"
            android:focusable="true" />

        <SeekBar
            android:id="@+id/mangaSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp" />

        <TextView
            android:id="@+id/mangaSliderPlus"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FF80D5D2"
            android:textSize="20sp"
            android:background="@drawable/manga_card_bg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/mangaSliderValue"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:gravity="end"
            android:textColor="#FFDDE4E3"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
