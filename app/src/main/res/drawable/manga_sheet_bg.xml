<?xml version="1.0" encoding="utf-8"?>
<!-- Floating quick-settings card: slightly lighter than the page surface so it
     reads as a window floating above the file browser. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF1B2221" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
