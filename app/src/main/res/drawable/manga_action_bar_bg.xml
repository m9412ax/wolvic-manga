<?xml version="1.0" encoding="utf-8"?>
<!-- Frame that groups the shelf actions (默认位置 / 加入书架 / 开始阅读 /
     继续阅读) in the browser header. It hugs its buttons so it never steals
     space from the title or the file grid. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF16201F" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
